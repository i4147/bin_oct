  {
    "type": "FunctionDef",
    "name": "read_key",
    "source": "def read_key(fd: int, timeout: float | None = None) -> str | None:\n    ready, _, _ = select.select([fd], [], [], timeout)\n    if not ready:\n        return None\n    first = os.read(fd, 1)\n    if not first:\n        return \"q\"\n    if first != b\"\\x1b\":\n        return first.decode(\"utf-8\", \"replace\")\n    seq = bytearray(first)\n    while len(seq) < 8:\n        ready, _, _ = select.select([fd], [], [], 0.03)\n        if not ready:\n            break\n        seq += os.read(fd, 1)\n        if seq[-1:].isalpha() or seq[-1:] == b\"~\":\n            break\n    return seq.decode(\"latin-1\")",
    "count": 3,
