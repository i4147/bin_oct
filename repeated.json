    "name": "unique_path",
    "source": "def unique_path(p: Path) -> Path:\n    if not p.exists():\n        return p\n    stem, suffix = p.stem, p.suffix\n    i = 1\n    while True:\n        cand = p.parent / f\"{stem}_{i}{suffix}\"\n        if not cand.exists():\n            return cand\n        i += 1",
